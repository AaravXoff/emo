# Copy to .env and customize. Do not commit .env.
# Pi 3B+ recommendation: install native Whisper.cpp with setup_whisper_cpp.sh.
# auto prefers Whisper.cpp when installed, otherwise tries Python Whisper.
WHISPER_BACKEND=auto
WHISPER_CPP_BIN=~/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=~/whisper.cpp/models/ggml-tiny.bin
WHISPER_CPP_THREADS=2
# Used only by the optional Python Whisper backend:
WHISPER_MODEL=tiny
WHISPER_TRANSLATION_MODEL=tiny
PRELOAD_WHISPER=false
WHISPER_DOWNLOAD_ROOT=~/.cache/whisper

AUDIO_SAMPLE_RATE=16000
# Optional microphone input device: blank/auto selects the default, then the first input.
# Set an integer device index or an exact sounddevice device name after checking sd.query_devices().
AUDIO_INPUT_DEVICE=auto
AUDIO_RMS_THRESHOLD=0.012
MAX_UTTERANCE_SECONDS=8
TRAILING_SILENCE_SECONDS=0.75
WAKE_WORD_REQUIRED=true
WAKE_WORDS=hey emo,hi emo,hello emo,okay emo,ok emo
WAKE_TIMEOUT_SECONDS=20

# If LM Studio runs on another computer, set its LAN IP below and enable its server.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-0.5b-instruct
LM_STUDIO_TIMEOUT_SECONDS=35

# Needed if a weather question does not specify a city.
WEATHER_CITY=

# TimeAPI.io zone (IANA name). Local Pi clock is used if the API is offline.
TIMEZONE=Asia/Kolkata

CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
WEATHER_CACHE_TTL_SECONDS=300
EMO_DATA_DIR=./data

# auto avoids Chatterbox on low-memory devices and falls back to espeak-ng.
TTS_ENGINE=auto
CHATTERBOX_LANGUAGE_MODE=multilingual

# Optional GPIO. 0 disables. Configure only after confirming your actual wiring.
TOUCH_GPIO=0
SERVO_GPIO=0

THERMAL_WARNING_C=75
THERMAL_LOCKOUT_C=82
THERMAL_RESUME_C=72
LOG_LEVEL=INFO
